/* ---------- Importación de datos reales ---------- */
function norm(x){return String(x==null?"":x).toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g,"").replace(/[^a-z0-9]/g,"")}
var COLMAP={negocio:"neg",restaurante:"neg",empresa:"neg",sociedad:"neg",mes:"mes",periodo:"mes",facturacion:"fact",ventas:"fact",ingresos:"fact",compras:"compras",consumos:"compras",personal:"personal",gestion:"gestion",otrosgastosdegestion:"gestion",gastosdegestion:"gestion",financiero:"fin",fin:"fin",gastosfinancieros:"fin",resultadofinanciero:"fin",alibio:"alibio",serviciosgrupoalibio:"alibio",serviciosalibio:"alibio"};
function pnum(v){
  if(v==null||v==="")return null;
  if(typeof v==="number")return isFinite(v)?v:null;
  var s=String(v).replace(/[€\s\u00a0]/g,"");if(!s)return null;
  var neg=/^\(.*\)$/.test(s);s=s.replace(/[()]/g,"");
  var c=s.indexOf(","),d=s.indexOf(".");
  if(c>=0&&d>=0){if(c>d)s=s.replace(/\./g,"").replace(",",".");else s=s.replace(/,/g,"")}
  else if(c>=0){s=s.replace(",",".")}
  else if(d>=0&&/^-?\d{1,3}(\.\d{3})+$/.test(s)){s=s.replace(/\./g,"")}
  var n=parseFloat(s);if(!isFinite(n))return null;return neg?-n:n;
}
function pmes(v){
  if(typeof v==="number"&&v>=1&&v<=12)return {m:v-1,y:null};
  var s=String(v==null?"":v).trim().toLowerCase();if(!s)return null;
  var y=null,m=null,r;
  r=s.match(/^(\d{4})[-\/](\d{1,2})/);
  if(r){y=+r[1];m=+r[2]}
  else{r=s.match(/^(\d{1,2})[-\/](\d{4})/);
    if(r){m=+r[1];y=+r[2]}
    else if(/^\d{1,2}$/.test(s)){m=+s}
    else{var k=norm(s).slice(0,3),i=-1;MESL.forEach(function(x,j){if(norm(x).slice(0,3)===k)i=j});if(i>=0)m=i+1;var ry=s.match(/(\d{4})/);if(ry)y=+ry[1]}}
  if(!m||m<1||m>12)return null;return {m:m-1,y:y};
}
function parseCSV(t){
  t=t.replace(/^\uFEFF/,"");var first=t.split(/\r?\n/)[0]||"";
  var del=first.split(";").length>=first.split(",").length?";":",";
  var rows=[],row=[],f="",q=false;
  for(var i=0;i<t.length;i++){var ch=t[i];
    if(q){if(ch==='"'){if(t[i+1]==='"'){f+='"';i++}else q=false}else f+=ch}
    else if(ch==='"')q=true;
    else if(ch===del){row.push(f);f=""}
    else if(ch==="\n"||ch==="\r"){if(ch==="\r"&&t[i+1]==="\n")i++;row.push(f);f="";rows.push(row);row=[]}
    else f+=ch;
  }
  if(f!==""||row.length){row.push(f);rows.push(row)}
  return rows;
}
function analyse(sheets){
  var res={items:[],errors:[],warns:[],skipped:0,found:false};
  var lookup={};ids().forEach(function(id){lookup[norm(id)]=id;lookup[norm(budget[id].name)]=id});
  for(var si=0;si<sheets.length;si++){
    var rows=sheets[si],hi=-1,map={};
    for(var r=0;r<Math.min(rows.length,30);r++){
      var mm={},has={};
      (rows[r]||[]).forEach(function(cell,ci){var k=COLMAP[norm(cell)];if(k&&mm[k]==null){mm[k]=ci;has[k]=1}});
      if(has.neg&&has.mes&&has.fact){hi=r;map=mm;break}
    }
    if(hi<0)continue;res.found=true;
    var seen={};
    for(var i=hi+1;i<rows.length;i++){
      var row=rows[i]||[];if(row.every(function(x){return x===""||x==null}))continue;
      var ln=i+1,nm=row[map.neg],id=lookup[norm(nm)];
      if(!id){res.errors.push("Fila "+ln+": negocio «"+nm+"» no reconocido.");continue}
      var pm=pmes(row[map.mes]);
      if(!pm){res.errors.push("Fila "+ln+": mes «"+row[map.mes]+"» no válido.");continue}
      if(pm.y&&pm.y!==2027){res.errors.push("Fila "+ln+": el año "+pm.y+" no es 2027.");continue}
      var fa=pnum(row[map.fact]);
      if(fa==null){res.skipped++;continue}
      var v={fact:fa};
      ["compras","personal","gestion","fin","alibio"].forEach(function(k){var n=map[k]==null?null:pnum(row[map[k]]);v[k]=n==null?0:n});
      var key=id+"|"+pm.m;
      if(seen[key]!=null){res.warns.push("Fila "+ln+": "+budget[id].name+" · "+MES[pm.m]+" duplicado; prevalece la última fila.");res.items[seen[key]]={id:id,m:pm.m,v:v}}
      else{seen[key]=res.items.length;res.items.push({id:id,m:pm.m,v:v})}
    }
    break;
  }
  return res;
}
function readFile(file){
  return new Promise(function(ok,ko){
    var ext=(file.name.split(".").pop()||"").toLowerCase(),fr=new FileReader();
    fr.onerror=function(){ko(new Error("No se pudo leer el archivo."))};
    if(ext==="csv"||ext==="txt"||ext==="tsv"){fr.onload=function(){ok([parseCSV(String(fr.result))])};fr.readAsText(file,"utf-8")}
    else if(ext==="xlsx"||ext==="xls"){
      if(!window.XLSX){ko(new Error("El lector de Excel no está disponible aquí; guarda el archivo como CSV."));return}
      fr.onload=function(){try{var wb=XLSX.read(fr.result,{type:"array"});ok(wb.SheetNames.map(function(n){return XLSX.utils.sheet_to_json(wb.Sheets[n],{header:1,raw:true,defval:""})}))}catch(e){ko(new Error("No se pudo interpretar el Excel."))}};
      fr.readAsArrayBuffer(file);
    }else ko(new Error("Formato no admitido. Usa .csv o .xlsx."));
  });
}
