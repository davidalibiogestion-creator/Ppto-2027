}
function commit(items){
  var go=document.getElementById("go"),st=document.getElementById("st");go.disabled=true;go.textContent="Cargando…";
  var by={};items.forEach(function(i){(by[i.id]=by[i.id]||[]).push(i)});
  var chain=Promise.resolve();
  Object.keys(by).forEach(function(id){
    chain=chain.then(function(){
      var cur=actuals[id],doc={};
      LINES.forEach(function(k){doc[k]=cur&&cur[k]?cur[k].slice():Array.apply(null,Array(12)).map(function(){return null})});
      by[id].forEach(function(i){LINES.forEach(function(k){doc[k][i.m]=i.v[k]})});
      return dbRef.doc("actuals/"+id).set(doc);
    });
  });
  chain.then(function(){
    var m=Object.assign({},meta||{});m.updated=new Date().toLocaleDateString("es-ES");
    return dbRef.doc("meta/info").set(m);
  }).then(function(){
    mb().innerHTML='<div class="msg ok"><b>Datos cargados.</b> Ya aparecen junto al presupuesto con sus desviaciones.</div><div class="row"><button class="btn pri" id="cx">Cerrar</button></div>';
    document.getElementById("cx").onclick=closeImport;
  }).catch(function(e){
    go.disabled=false;go.textContent="Reintentar";
    st.innerHTML='<div class="msg err">No se pudo guardar'+(e&&e.code==="invalid_argument"?": no tienes permiso de escritura en estos datos.":".")+'</div>';
  });
}
document.addEventListener("keydown",function(e){if(e.key==="Escape")closeImport()});

/* ---------- Simulador de escenarios (por negocio) ---------- */
var SHORT={fact:"ventas",compras:"compras",personal:"personal",gestion:"gestión",fin:"financieros",alibio:"serv. Alibio"};
function sgn(v){return v>0?"+"+v+" %":(v<0?"−"+Math.abs(v)+" %":"0 %")}
function esc(t){return String(t==null?"":t).replace(/&/g,"&amp;").replace(/</g,"&lt;")}
function opsIds(){return ids().filter(function(i){return budget[i].group!=="serv"})}
function tabIds(){return S.simTab==="all"?opsIds():(S.simTab&&budget[S.simTab]?[S.simTab]:[])}
function newEntry(d){var f={};LINES.forEach(function(k){f[k]=d});return {fact:0,compras:0,personal:0,gestion:0,fin:0,alibio:0,link:false,from:f}}
function defFrom(){var l=through();return l>=0?Math.min(11,l+1):0}
function ent(id){if(!S.sim[id])S.sim[id]=newEntry(defFrom());if(!S.sim[id].from)S.sim[id].from=newEntry(0).from;return S.sim[id]}
function getFrom(id,k){var x=S.sim[id];return x?((x.from&&x.from[k])||0):defFrom()}
function tabFrom(k){var t=tabIds();if(!t.length)return 0;return getFrom(t[0],k)}
function tabFromAll(){var t=tabIds();if(!t.length)return 0;var v=getFrom(t[0],LINES[0]),mixed=false;t.forEach(function(id){LINES.forEach(function(k){if(getFrom(id,k)!==v)mixed=true})});return mixed?-1:v}
function simVal(id,k){var x=S.sim[id];return x?(x[k]||0):0}
function tabVal(k){var t=tabIds();if(!t.length)return {v:0,mixed:false};var v0=simVal(t[0],k),mixed=t.some(function(i){return simVal(i,k)!==v0});return {v:mixed?0:v0,mixed:mixed}}
function tabLink(){var t=tabIds();return t.length>0&&t.every(function(i){return S.sim[i]&&S.sim[i].link})}
function hasAdj(id){var x=S.sim[id];return !!x&&LINES.some(function(k){return x[k]})}
function simAdj(id){var x=S.sim[id],o=[];if(!x)return o;LINES.forEach(function(k){if(x[k]){var f=(x.from&&x.from[k])||0;o.push(SHORT[k]+" "+sgn(x[k])+(f?" desde "+MES[f]:""))}});if(x.link&&x.fact)o.push("compras ligadas a ventas");return o}
var MOPT=MES.map(function(m,i){return '<option value="'+i+'">'+m+'</option>'}).join("");
function buildSim(){
  var h='<p class="sd">Ajusta cada negocio por separado y elige desde qué mes se aplica cada ajuste: los cambios se suman en Grupo, Consolidado, Operaciones, Restaurantes y Distribución. «Todos» aplica el mismo ajuste a todos los negocios operativos (sin Alibio Gestión). No modifica los datos guardados.</p><div class="chips" id="stabs" style="flex-wrap:wrap"></div><div class="stitle" id="stitle"></div><div class="sfall"><label>⏱ Aplicar los ajustes desde <select id="sfall"></select> de 2027</label><span>Los meses anteriores conservan el presupuesto base: una subida decidida en marzo se aplica desde abril.</span></div><div class="sl-grid">';
  SIMDEF.forEach(function(x){
    h+='<div class="sl" id="sl-'+x[0]+'"><div class="sh"><span id="sn-'+x[0]+'">'+x[1]+'</span><b id="sv-'+x[0]+'">0 %</b></div><div class="sr"><button class="sb" data-sd="'+x[0]+'" data-dir="-1" aria-label="Restar 5 % a '+x[1]+'">−</button><input type="range" id="sr-'+x[0]+'" data-sim="'+x[0]+'" min="-30" max="30" step="5" value="0" aria-label="'+x[1]+'"><button class="sb" data-sd="'+x[0]+'" data-dir="1" aria-label="Sumar 5 % a '+x[1]+'">+</button></div><div class="sc"><span>−30 %</span><span>0</span><span>+30 %</span></div><div class="sf"><span>Aplicar desde</span><select data-sf="'+x[0]+'" aria-label="Aplicar desde, '+x[1]+'">'+MOPT+'</select></div></div>';
  });
  h+='</div><label class="lk"><input type="checkbox" id="sim-link"> Las compras acompañan a las ventas (suben o bajan con ellas)</label><div class="sd" id="shint" style="margin:8px 0 0"></div><div id="smatrix"></div>';
  h+='<div class="sact"><button class="btn" id="sreset1">Restablecer selección</button><button class="btn" id="sreset">Restablecer todo</button><span id="sgrp" style="display:none;gap:8px;flex-wrap:wrap;align-items:center"><input type="text" id="sn" placeholder="Nombre del escenario" maxlength="40"><button class="btn" id="ssave">Guardar</button><select id="ssel" aria-label="Escenarios guardados"></select><button class="btn" id="sdel">Borrar</button></span></div><div id="smsg"></div>';
  document.getElementById("simbody").innerHTML=h;
  refreshSim();
}
function refreshSim(){
  if(loaded.b&&S.simTab!=="all"&&(!S.simTab||!budget[S.simTab])&&ids().length)S.simTab=ids()[0];
  var st=document.getElementById("stabs");
  if(st){var h=chip("Todos a la vez","st","all",S.simTab);ids().forEach(function(id){h+=chip(esc(budget[id].name)+(hasAdj(id)?' <span style="color:var(--accent)">●</span>':""),"st",id,S.simTab)});st.innerHTML=h}
  var isAl=S.simTab!=="all"&&budget[S.simTab]&&budget[S.simTab].group==="serv";
  var tt=document.getElementById("stitle");
  if(tt)tt.innerHTML=S.simTab==="all"?"Ajustando <b>todos los negocios operativos a la vez</b> (el mismo % en cada uno)":"Ajustando <b>solo "+esc(budget[S.simTab]?budget[S.simTab].name:"")+"</b>";
  SIMDEF.forEach(function(x){
    var tv=tabVal(x[0]),r=document.getElementById("sr-"+x[0]),b=document.getElementById("sv-"+x[0]),w=document.getElementById("sl-"+x[0]);
    if(r)r.value=tv.v;
    if(b){b.textContent=tv.mixed?"mixto":sgn(tv.v);b.className=(!tv.mixed&&tv.v>0)?"up":((!tv.mixed&&tv.v<0)?"dn":"")}
    if(w&&x[0]==="alibio")w.style.display=isAl?"none":"";
  });
  var nf2=document.getElementById("sn-fact");if(nf2)nf2.textContent=isAl?"Ventas (servicios al grupo)":"Ventas";
  SIMDEF.forEach(function(x){var q=document.querySelector('[data-sf="'+x[0]+'"]');if(q)q.value=tabFrom(x[0])});
  var fa=document.getElementById("sfall");if(fa){var tv2=tabFromAll();fa.innerHTML=(tv2<0?'<option value="-1">varios</option>':"")+MOPT;fa.value=tv2}
  var lk=document.getElementById("sim-link");if(lk){lk.checked=tabLink();lk.disabled=!!isAl}
  var hint=document.getElementById("shint");if(hint)hint.textContent=isAl?"Alibio Gestión factura al grupo sus servicios. Si cambias «Servicios Grupo Alibio» en los negocios, ajusta aquí sus ventas en la misma proporción para que el intragrupo cuadre.":"";
  var mx=document.getElementById("smatrix");
  if(mx){
    if(!simOn())mx.innerHTML="";
    else{
      var t='<div class="tw" style="margin-top:12px"><table><thead><tr><th>Ajustes por negocio</th>'+SIMDEF.map(function(x){return "<th>"+SHORT[x[0]]+"</th>"}).join("")+'</tr></thead><tbody>';
      ids().forEach(function(id){if(!hasAdj(id))return;t+='<tr><td>'+esc(budget[id].name)+'</td>'+SIMDEF.map(function(x){var v=simVal(id,x[0]),fm=getFrom(id,x[0]);return '<td class="'+(v>0?"up":(v<0?"dn":""))+'">'+(v?sgn(v)+(fm?'<br><small>desde '+MES[fm]+'</small>':""):"–")+'</td>'}).join("")+'</tr>'});
      mx.innerHTML=t+'</tbody></table></div>';
    }
  }
  var bd=document.getElementById("simbadge");if(bd)bd.innerHTML=simOn()?'<span class="on">Escenario activo</span>':"";
  var g=document.getElementById("sgrp");if(g)g.style.display=(canW&&dbRef)?"inline-flex":"none";
  var sel=document.getElementById("ssel");
  if(sel){var cur=sel.value,o='<option value="">Escenarios guardados…</option>';
    Object.keys(scen).sort(function(a,b){return (scen[a].at||0)-(scen[b].at||0)}).forEach(function(id){o+='<option value="'+id+'">'+esc(scen[id].name||id)+'</option>'});
    sel.innerHTML=o;if(scen[cur])sel.value=cur}
}
function simMsg(t,err){var m=document.getElementById("smsg");if(m)m.innerHTML=t?'<div class="msg '+(err?"err":"ok")+'">'+t+'</div>':""}
function setSim(k,v){
  v=Math.max(-30,Math.min(30,v));
  tabIds().forEach(function(id){var x=ent(id);x[k]=v});
  refreshSim();render();
}
function simCard(c){
  var el=S.scope==="consolidado",B0=build(c.list,"b",el,true),n=0,adj=[];
  c.list.forEach(function(id){var a=simAdj(id);if(a.length){n++;adj.push('<li><b>'+esc(budget[id].name)+':</b> '+a.join(", ")+'</li>')}});
  var h='<div class="card scard"><h2><span>Escenario vs. presupuesto base</span><span class="on" style="background:var(--warn-bg);color:var(--warn);border-radius:999px;font-size:11px;padding:2px 9px">'+n+' negocio'+(n===1?"":"s")+' ajustado'+(n===1?"":"s")+'</span></h2>';
  h+='<div class="note" style="margin-top:0">'+scopeName(S.scope)+' · '+periodLabel(S.period)+'. Las tarjetas, gráficos y desviaciones de esta página usan ya el presupuesto del escenario.</div>';
  if(adj.length)h+='<ul class="adj">'+adj.join("")+'</ul>';
  else h+='<div class="note">Los ajustes activos no afectan a los negocios de este ámbito.</div>';
  h+='<div class="tw"><table><thead><tr><th>Concepto</th><th>Base</th><th>Escenario</th><th>Δ €</th><th>Δ %</th></tr></thead><tbody>';
  ROWS.forEach(function(r){
    var b=sumIdx(B0[r.k],c.use),e=sumIdx(c.B[r.k],c.use),d=e-b,cl=Math.abs(d)<0.5?"":(fav(r.t,d)==="good"?"up":"dn");
    h+='<tr'+(r.c?' class="'+r.c+'"':"")+'><td>'+r.l+'</td><td>'+num(b)+'</td><td>'+num(e)+'</td><td class="'+cl+'">'+dnum(d)+'</td><td class="'+cl+'">'+(b?dpct(d/Math.abs(b)*100):"–")+'</td></tr>';
  });
  var fb=sumIdx(B0.fact,c.use),fe=sumIdx(c.B.fact,c.use),tb=sumIdx(B0.total,c.use),te=sumIdx(c.B.total,c.use);
  if(fb&&fe)h+='<tr><td>Margen total s/ ventas</td><td>'+pct(tb/fb*100)+'</td><td>'+pct(te/fe*100)+'</td><td colspan="2">'+pfs.format(te/fe*100-tb/fb*100)+' pp</td></tr>';
  return h+'</tbody></table></div></div>';
}
function simEvents(){
  var box=document.getElementById("simbody");
  box.addEventListener("input",function(e){var k=e.target.dataset&&e.target.dataset.sim;if(k)setSim(k,+e.target.value)});
  box.addEventListener("change",function(e){
    if(e.target.dataset&&e.target.dataset.sf){var fk=e.target.dataset.sf,fv=+e.target.value;tabIds().forEach(function(id){ent(id).from[fk]=fv});refreshSim();render();return}
    if(e.target.id==="sfall"){var av=+e.target.value;if(av>=0){tabIds().forEach(function(id){var x=ent(id);LINES.forEach(function(k){x.from[k]=av})});refreshSim();render()}return}
    if(e.target.id==="sim-link"){var on=e.target.checked;tabIds().forEach(function(id){ent(id).link=on});refreshSim();render()}
    if(e.target.id==="ssel"&&e.target.value){
      var sc=scen[e.target.value];
      if(sc&&sc.sim){
        var ns={};
        if(sc.sim.fact!==undefined){opsIds().forEach(function(id){ns[id]=Object.assign(newEntry(0),sc.sim)})}
        else Object.keys(sc.sim).forEach(function(id){if(budget[id])ns[id]=Object.assign(newEntry(0),sc.sim[id])});
        S.sim=ns;refreshSim();render();simMsg("Escenario «"+esc(sc.name)+"» cargado.");
      }
    }
  });
  box.addEventListener("click",function(e){
    var t=e.target.closest("button");if(!t)return;
    if(t.dataset.st){S.simTab=t.dataset.st;refreshSim();return}
    if(t.dataset.sd){var cv=tabVal(t.dataset.sd);setSim(t.dataset.sd,cv.v+5*(+t.dataset.dir));return}
    if(t.id==="sreset1"){tabIds().forEach(function(id){delete S.sim[id]});refreshSim();render();simMsg("");return}
    if(t.id==="sreset"){S.sim={};refreshSim();render();simMsg("");return}
    if(t.id==="ssave"){
      var nm=(document.getElementById("sn").value||"").trim();
      if(!nm){simMsg("Ponle un nombre al escenario.",true);return}
      if(!simOn()){simMsg("Mueve algún deslizador antes de guardar.",true);return}
      var id="s"+Date.now(),sim={};
      Object.keys(S.sim).forEach(function(k){if(hasAdj(k))sim[k]=Object.assign({},S.sim[k])});
      dbRef.doc("scenarios/"+id).set({name:nm,at:Date.now(),sim:sim}).then(function(){document.getElementById("sn").value="";simMsg("Escenario guardado.")}).catch(function(){simMsg("No se pudo guardar el escenario.",true)});
      return;
    }
    if(t.id==="sdel"){
      var v=document.getElementById("ssel").value;if(!v){simMsg("Elige primero un escenario guardado.",true);return}
      dbRef.doc("scenarios/"+v).delete().then(function(){simMsg("Escenario borrado.")}).catch(function(){simMsg("No se pudo borrar.",true)});
    }
  });
}

function chip(label,attr,val,cur,extra){
  return '<button class="chip'+(extra||"")+'" data-'+attr+'="'+val+'" aria-pressed="'+(cur===val)+'">'+label+'</button>';
}

function render(){
  var app=document.getElementById("app");
  if(!dbOK){app.innerHTML='<div class="empty">Los datos compartidos no están disponibles en esta vista.</div>';return}
  if(!loaded.b){return}
  if(!ids().length){app.innerHTML='<div class="empty">El presupuesto todavía no está cargado.</div>';return}
  if(!budget[S.scope]&&["grupo","consolidado","operaciones","restaurantes","distribucion"].indexOf(S.scope)<0)S.scope="grupo";
  var c=ctx(S.scope),last=through();
  var st=document.getElementById("status");
  st.innerHTML='<span class="badge'+(last>=0?" on":"")+'"><i></i>'+(last>=0?"Real cargado hasta "+MESL[last]+" 2027":"Solo presupuesto · sin datos reales aún")+'</span>'+(canW&&dbRef?' <button class="btn" id="imp" style="margin-left:8px">Cargar datos reales</button>':'');

  var h='<div class="controls"><div class="lbl">Ámbito</div><div class="chips">';
  [["grupo","Grupo"],["consolidado","Consolidado"],["operaciones","Operaciones"],["restaurantes","Restaurantes"],["distribucion","Distribución"]].forEach(function(x){h+=chip(x[1],"scope",x[0],S.scope)});
  h+='</div><div class="chips" style="margin-top:6px">';
  ids().forEach(function(id){h+=chip(budget[id].name,"scope",id,S.scope)});
  h+='</div><div class="lbl">Periodo</div><div class="chips">';
  [["ytd","Acumulado"],["year","Año"],["q1","T1"],["q2","T2"],["q3","T3"],["q4","T4"]].forEach(function(x){h+=chip(x[1],"period",x[0],S.period)});
  h+='<select class="chip" id="msel" aria-label="Mes" aria-pressed="'+(S.period[0]==="m")+'" style="'+(S.period[0]==="m"?"background:var(--ink);color:var(--bg)":"")+'"><option value="">Mes…</option>';
  MES.forEach(function(m,i){h+='<option value="m'+i+'"'+(S.period==="m"+i?" selected":"")+'>'+m+'</option>'});
  h+='</select></div></div>';
  var ctl=document.getElementById("ctl");ctl.innerHTML=h;h="";

  if(!c.hasAny)h+='<div class="banner">Aún no hay datos reales. Cuando se carguen aparecerán junto al presupuesto, con sus desviaciones.</div>';
  else if(c.M.length!==c.use.length||!c.cmp)h+='<div class="note">Periodo con real parcial: se compara solo '+(c.cmp?c.use.map(function(i){return MES[i]}).join(", "):"")+' (meses con datos reales).</div>';
  else h+='<div class="note">'+scopeName(S.scope)+' · '+periodLabel(S.period)+' · comparando '+c.use.length+' '+(c.use.length===1?"mes":"meses")+' con datos reales.</div>';

  if(S.scope==="grupo")h+='<div class="note">Incluye Alibio Gestión: sus servicios intragrupo ('+eur(elimTotal())+') suman a la facturación del grupo y restan como gasto en cada negocio. «Consolidado» los elimina; el resultado total es el mismo.</div>';
  if(S.scope==="consolidado")h+='<div class="note">Vista consolidada: se eliminan los servicios intragrupo de Alibio Gestión ('+eur(elimTotal())+' de facturación y de gasto). El resultado total coincide con el Excel.</div>';
  var f=rowVals(c,"fact"),d=rowVals(c,"directo"),t=rowVals(c,"total");
  var mg={b:f.b?t.b/f.b*100:null,a:(f.a&&t.a!=null)?t.a/f.a*100:null};
  h+='<div class="grid kpis">'+kpiCard("Facturación",f)+kpiCard("Resultado directo",d)+kpiCard("Resultado total",t)+kpiCard("Margen total s/ ventas",mg,true)+'</div>';
  app.innerHTML=h;h="";
  if(simOn())h+=simCard(c);

  h+='<div class="two"><div class="card"><h2><span>Evolución mensual</span><span class="legend"><span class="lb">Ppto</span><span class="la">Real</span></span></h2><div class="chips" style="margin-bottom:8px">';
  [["fact","Facturación"],["total","Resultado total"],["personal","Personal"],["compras","Compras"]].forEach(function(x){h+=chip(x[1],"metric",x[0],S.metric)});
  h+='</div>'+chartSVG(c)+monthDetail(c)+'</div>'+alertsCard(c)+'</div>';

  h+='<div class="two"><div class="card"><h2>Cuenta de resultados · '+periodLabel(S.period)+'</h2>'+summaryTable(c)+'</div>'+(c.list.length>1?bizList(c):coverage())+'</div>';

  h+='<div class="card" style="margin-top:12px"><h2><span>Detalle mensual</span><span class="chips">'+chip("Presupuesto","mode","b",S.mode)+chip("Real","mode","a",S.mode)+chip("Desviación","mode","d",S.mode)+'</span></h2>'+monthlyTable(c)+'</div>';
  if(c.list.length>1)h+='<div style="margin-top:12px">'+coverage()+'</div>';
  if(dl)h+='<div style="margin-top:12px"><button class="btn" id="exp">Exportar CSV (ámbito actual)</button></div>';
  document.getElementById("app2").innerHTML=h;

  var chips=ctl.querySelector(".controls .chips");
  var sc=ctl.querySelector('[data-scope][aria-pressed="true"]');if(sc&&app._sx==null){app._sx=1;sc.scrollIntoView({inline:"center",block:"nearest"})}
  var foot=document.getElementById("foot");
  foot.textContent="Fuente del presupuesto: "+((meta&&meta.source)||"libro de tesorería oct. 2026 – dic. 2027")+(meta&&meta.updated?" · última actualización de datos: "+meta.updated:"")+". Desviación = Real − Presupuesto; en verde la favorable, en rojo la desfavorable.";
}

document.addEventListener("click",function(e){
  var t=e.target.closest("[data-scope],[data-period],[data-metric],[data-mode],[data-m],#exp,#imp");
  if(!t)return;
  if(t.id==="exp"){exportCSV();return}
  if(t.id==="imp"){openImport();return}
  if(t.dataset.scope){S.scope=t.dataset.scope;if(budget[S.scope]){S.simTab=S.scope;refreshSim()}}
  else if(t.dataset.period){S.period=t.dataset.period}
  else if(t.dataset.metric){S.metric=t.dataset.metric}
  else if(t.dataset.mode){S.mode=t.dataset.mode}
  else if(t.dataset.m!=null){S.month=S.month===+t.dataset.m?null:+t.dataset.m}
  var y=window.scrollY,cs=document.querySelector(".controls .chips");var sx=cs?cs.scrollLeft:0;
  render();
  var ncs=document.querySelector(".controls .chips");if(ncs)ncs.scrollLeft=sx;
  window.scrollTo(0,y);
});
document.addEventListener("change",function(e){
  if(e.target.id==="msel"&&e.target.value){S.period=e.target.value;render()}
});

function snapMap(snap){var o={};snap.docs.forEach(function(d){o[d.id]=d.data()});return o}
function fail(){dbOK=false;render()}
buildSim();simEvents();
document.getElementById("simfab").addEventListener("click",function(){var b=document.getElementById("simbox");b.open=true;b.scrollIntoView({behavior:"smooth",block:"start"})});
if(!window.claude||!window.claude.use){dbOK=false;render()}
else{
  window.claude.use("user").then(function(u){return u?u.can("data.write"):null}).then(function(v){canW=v!==false;refreshSim();if(loaded.b)render()}).catch(function(){});
  window.claude.use("downloads").then(function(d){dl=d;if(loaded.b)render()}).catch(function(){});
  window.claude.use("db").then(function(db){
    if(!db){fail();return}
    dbRef=db;refreshSim();
    db.collection("scenarios").onSnapshot(function(s){scen=snapMap(s);refreshSim()},function(){});
    db.collection("budget").onSnapshot(function(s){budget=snapMap(s);loaded.b=true;refreshSim();render()},fail);
    db.collection("actuals").onSnapshot(function(s){actuals=snapMap(s);loaded.a=true;render()},function(){});
    db.doc("meta/info").onSnapshot(function(s){meta=s.exists?s.data():null;render()},function(){});
  }).catch(fail);
}
})();
</script>
