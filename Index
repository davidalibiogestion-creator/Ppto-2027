  if(r.warns.length)h+='<div class="msg wr"><ul>'+r.warns.slice(0,5).map(function(x){return "<li>"+x+"</li>"}).join("")+'</ul></div>';
  if(r.skipped)h+='<div class="note">'+r.skipped+' fila(s) sin facturación omitidas.</div>';
  if(!r.items.length){h+='<div class="msg err">No hay filas válidas para cargar.</div><div class="row"><button class="btn" id="bk">Volver</button></div>';mb().innerHTML=h;document.getElementById("bk").onclick=function(){stepPick()};return}
