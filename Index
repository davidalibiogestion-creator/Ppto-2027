  var over=0;
  order.forEach(function(id){
    var it=by[id],fr=0,fb=0,ov=0;
    it.forEach(function(i){fr+=i.v.fact;fb+=(budget[id].fact&&budget[id].fact[i.m])||0;if(actuals[id]&&actuals[id].fact&&actuals[id].fact[i.m]!=null)ov++});
    over+=ov;
    var mm=it.map(function(i){return MES[i.m]}).join(", ");
    h+='<tr><td>'+budget[id].name+'</td><td style="white-space:normal;text-align:left">'+mm+'</td><td>'+num(fr)+'</td><td>'+num(fb)+'</td><td>'+(ov?ov+" mes(es)":"–")+'</td></tr>';
  });
  h+='</tbody></table></div>';
  h+='<div class="row"><button class="btn" id="bk">Elegir otro</button><button class="btn pri" id="go">Cargar '+r.items.length+' registros'+(over?" (sobrescribe "+over+")":"")+'</button></div><div id="st"></div>';
  mb().innerHTML=h;
